@page "/accounts"
@inject IAccountService AccountService

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

<input type="text" @bind="newAccountName" placeholder="Account Name"/>

<select @bind="selectedType">
    <option>Savings</option>
    <option>Checking</option>
</select>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color: red;">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <p style="color: green;">@successMessage</p>
}
<button @onclick="CreateAccount">Create Account</button>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Balance</th>
            <th>Last Updated</th>
            <th>Account Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var account in accounts)
        {
            <tr>
                <td>@account.Name</td>
                <td>@account.Balance</td>
                <td>@account.LastUpdate</td>
                <td>@account.AccountType</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string newAccountName = "";

    private string selectedType = "Savings";

    private string errorMessage = "";

    private string successMessage = "";
    
    private List<BankAccount> accounts = new List<BankAccount>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AccountService.InitializeAsync();
            accounts = await AccountService.GetAccounts();
            StateHasChanged();
        }
    }

    private async Task CreateAccount()
    {
        errorMessage = "";
        successMessage = "";
        
        if (string.IsNullOrWhiteSpace(newAccountName))
        {
            errorMessage = "Account name can not be empty.";
            return;
        }
        
        var account = new BankAccount()
        {
            Id = Guid.NewGuid(),
            Name = newAccountName,
            AccountType = Enum.Parse<AccountType>(selectedType)
        };

        await AccountService.CreateAccount(account);
        accounts = await AccountService.GetAccounts();

        successMessage = $"Account '{newAccountName}' successfully created!";
        newAccountName = "";
    }
}