@page "/newtransaction"
@inject IAccountService AccountService

<PageTitle>Transaction</PageTitle>

<h1>New Transaction</h1>

<select @bind="selectedType">
    <option>Deposit</option>
    <option>Withdraw</option>
    <option>Transfer</option>
</select>

<p>From account</p>
<select @bind="selectedAccountId">
    <option value="">Select account</option>
    @foreach (var account in accounts)
    {
        <option value="@account.Id">@account.Name</option>
    }
</select>

@if (selectedType == "Transfer")
{
    <p>To account</p>
    <select @bind="selectedToAccountId">
        <option value="">Select account</option>
        @foreach (var account in accounts)
        {
            <option value="@account.Id">@account.Name</option>
        }
    </select>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color: red;">@errorMessage</p>
}

<p>Amount</p>
<input type="number" @bind="amount" />
<button @onclick="ExecuteTransaction">Execute Transaction</button>

@code {
    private string selectedType = "Deposit";

    private string selectedAccountId = "";
    
    private string selectedToAccountId = "";

    private string errorMessage = "";

    private decimal amount;

    private List<BankAccount> accounts = new List<BankAccount>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AccountService.InitializeAsync();
            accounts = await AccountService.GetAccounts();
            StateHasChanged();
        }
    }

    private async Task ExecuteTransaction()
    {
        errorMessage = "";

        if (string.IsNullOrEmpty(selectedAccountId))
        {
            errorMessage = "Please select an account.";
            return;
        }

        if (selectedType == "Transfer" && string.IsNullOrEmpty(selectedToAccountId))
        {
            errorMessage = "Please select a destination account.";
            return;
        }
        
        if (selectedType == "Transfer" && selectedAccountId == selectedToAccountId)
        {
            errorMessage = "Cannot transfer to the same account.";
            return;
        }
        
        if (amount <= 0)
        {
            errorMessage = "Amount must be greater than 0.";
            return;
        }

        try
        {
            if (selectedType == "Deposit")
            {
                await AccountService.Deposit(Guid.Parse(selectedAccountId), amount);
            }
            else if (selectedType == "Withdraw")
            {
                await AccountService.Withdraw(Guid.Parse(selectedAccountId), amount);
            }
            else if (selectedType == "Transfer")
            {
                await AccountService.Transfer(Guid.Parse(selectedAccountId), Guid.Parse(selectedToAccountId), amount);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}