@page "/history"
@inject IAccountService AccountService

<PageTitle>History</PageTitle>

<h1>History</h1>
<select @bind="selectedAccountId">
    <option value="">Select account</option>
    @foreach (var account in accounts)
    {
        <option value="@account.Id">@account.Name</option>
    }
</select>

<input type="date" @bind="startDate" />
<input type="date" @bind="endDate" />

<select @bind="selectedTransactionType">
    <option value="">All types</option>
    <option value="Deposit">Deposit</option>
    <option value="Withdraw">Withdraw</option>
    <option value="Transfer">Transfer</option>
</select>

<select @bind="sortBy">
    <option value="date">Date</option>
    <option value="amount">Amount</option>
</select>

<select @bind="sortDirection">
    <option value="asc">Ascending</option>
    <option value="desc">Descending</option>
</select>

<button @onclick="ApplyFilter">Search</button>

<table>
    <thead>
    <tr>
        <th>Date</th>
        <th>Transaction Type</th>
        <th>Amount</th>
        <th>Balance After</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var transaction in transactions)
    {
        <tr>
            <td>@transaction.Date</td>
            <td>@transaction.TransactionType</td>
            <td>@transaction.Amount SEK</td>
            <td>@transaction.BalanceAfter SEK</td>
        </tr>
    }
    </tbody>
</table>

@code {
    private DateTime startDate = DateTime.Now.AddYears(-1);
    private DateTime endDate = DateTime.Now;
    private string selectedTransactionType = "";
    private string sortBy = "date";
    private string sortDirection = "asc";
    
    private string _selectedAccountId = "";
    private string selectedAccountId
    {
        get => _selectedAccountId;
        set
        {
            _selectedAccountId = value;
            _ = LoadTransactions();
        }
    }
    
    private List<Transaction> transactions = new List<Transaction>();

    private List<BankAccount> accounts = new List<BankAccount>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AccountService.InitializeAsync();
            accounts = await AccountService.GetAccounts();
            StateHasChanged();
        }
    }

    private async Task LoadTransactions()
    {
        if (!string.IsNullOrEmpty(selectedAccountId))
        {
            var allTransactions = await AccountService.GetTransactionHistory(Guid.Parse(selectedAccountId));

            var filtered = allTransactions
                .Where(t => t.Date.Date >= startDate.Date && t.Date.Date <= endDate.Date);

            if (!string.IsNullOrEmpty(selectedTransactionType))
            {
                filtered = filtered.Where(t => t.TransactionType.ToString() == selectedTransactionType);
            }

            if (sortBy == "date")
                transactions = sortDirection == "asc"
                    ? filtered.OrderBy(t => t.Date).ToList()
                    : filtered.OrderByDescending(t => t.Date).ToList();
            else
                transactions = sortDirection == "asc"
                    ? filtered.OrderBy(t => t.Amount).ToList()
                    : filtered.OrderByDescending(t => t.Amount).ToList();
        }
        else
        {
            transactions = new List<Transaction>();
        }
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        if (startDate > endDate)
        {
            (startDate, endDate) = (endDate, startDate);
        }
        _ = LoadTransactions();
    }
}
